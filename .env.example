# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/nextcloud_saas"

# ─────────────────────────────────────────────
# NEXTAUTH
# ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# ─────────────────────────────────────────────
# STRIPE
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs (from Stripe Dashboard)
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PERSONAL="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_BUSINESS="price_..."

# ─────────────────────────────────────────────
# S3-COMPATIBLE OBJECT STORAGE
# ─────────────────────────────────────────────
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET_NAME="nextcloud-saas-default"
S3_FORCE_PATH_STYLE="true"

# ─────────────────────────────────────────────
# NEXTCLOUD
# ─────────────────────────────────────────────
NEXTCLOUD_ADMIN_USER="admin"
NEXTCLOUD_ADMIN_PASSWORD="change-me-strong-password"
NEXTCLOUD_BASE_DOMAIN="yourdomain.com"
NEXTCLOUD_DOCKER_IMAGE="nextcloud:28"
NEXTCLOUD_PORT_START="8100"

# ─────────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────────
APP_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
USER_PANEL_URL="http://localhost:3002"
NODE_ENV="development"

# ─────────────────────────────────────────────
# EMAIL (SMTP)
# ─────────────────────────────────────────────
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="noreply@yourdomain.com"

# ─────────────────────────────────────────────
# REDIS (optional, for queue/session)
# ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────
# ENCRYPTION (for S3 secrets stored in DB)
# ─────────────────────────────────────────────
ENCRYPTION_KEY="32-char-random-string-here!!!!!"
